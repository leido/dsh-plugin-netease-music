{
  "name": "dsh-plugin-netease-music",
  "version": "0.2.5",
  "description": "网易云音乐 for DSH Web UI：用官方 ncm-cli 搜索、播放与控制，含设置页配置与 Agent 工具。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node scripts/check-tool-schemas.mjs && node scripts/check-normalizer.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "netease-music",
    "ncm-cli",
    "music"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leido/dsh-plugin-netease-music.git"
  },
  "homepage": "https://github.com/leido/dsh-plugin-netease-music#readme",
  "bugs": {
    "url": "https://github.com/leido/dsh-plugin-netease-music/issues"
  }
}
